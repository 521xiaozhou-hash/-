HOST=0.0.0.0
PORT=8080
REQUEST_TIMEOUT=6
# Server-side market data refresh intervals.
ALPHA_REFRESH_SECONDS=60
BSTOCK_REFRESH_SECONDS=5
# Leave empty to monitor all Alpha tokens returned by Binance.
ALPHA_SYMBOLS=
# Binance RWA bStock tickers to monitor.
BSTOCK_TICKERS=AAPL,TSLA,NVDA,MSTR
# Program OTA update token. The installer generates this automatically.
UPDATE_TOKEN=
# GitHub OTA check interval (seconds).
UPDATE_CHECK_SECONDS=15
