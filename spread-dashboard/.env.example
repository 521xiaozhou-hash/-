HOST=0.0.0.0
PORT=8080
REQUEST_TIMEOUT=6
ALPHA_REFRESH_SECONDS=60
BSTOCK_REFRESH_SECONDS=30
# Leave empty to monitor all Alpha tokens returned by Binance.
ALPHA_SYMBOLS=
# Leave empty to monitor all Binance bStocks returned by Binance RWA type=3.
BSTOCK_TICKERS=
# Local blacklist. Symbols/coins can also be edited from the web UI.
BLACKLIST_FILE=blacklist.json
# Program OTA update token. The installer generates this automatically.
UPDATE_TOKEN=
UPDATE_CHECK_SECONDS=15
